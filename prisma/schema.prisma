// Increment: Project Source intake. The original uploaded file is immutable
// evidence, stored in S3-compatible object storage (StorageProvider); only
// metadata/hash/reference and, when locally extractable, the extracted text
// live here. Never replaced by a cleaned AI interpretation — that is the
// separate, optional SourceReportDetail.
model SourceDetail {
  artifactVersionId       String                @id @map("artifact_version_id") @db.Uuid
  sourceKind              ProjectSourceKind     @map("source_kind")
  // User-defined meaning/purpose (spec 2.2) — never inferred.
  purpose                 String
  businessArea            String?               @map("business_area")
  // Required user-entered content; also the sole source of extractedText
  // when no file is uploaded (file upload is optional — spec: a source's
  // knowledge can come from typed content alone).
  description             String
  originalFilename        String?               @map("original_filename")
  mimeType                String?               @map("mime_type")
  sizeBytes               Int?                  @map("size_bytes")
  contentHash             String?               @map("content_hash")
  storageKey              String?               @map("storage_key")
  language                String?
  extractionState         SourceExtractionState @map("extraction_state")
  extractedText           String?               @map("extracted_text")
  extractionFailureReason SourceFailureReason?  @map("extraction_failure_reason")

  artifactVersion ArtifactVersion     @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  report          SourceReportDetail?

  @@index([contentHash])
  @@map("source_details")
}

// One candidate-first AI interpretation attempt for one exact source version.
// Deliberately one candidate per generation call (an interpretation is not a
// menu of alternatives); acceptance is still a distinct explicit action.
model SourceReportCandidate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  sourceVersionId String   @map("source_version_id") @db.Uuid
  aiRunId         String   @unique @map("ai_run_id") @db.Uuid
  content         Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceVersion  ArtifactVersion     @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  aiRun          AIRun               @relation(fields: [aiRunId], references: [id], onDelete: Restrict)
  acceptedDetail SourceReportDetail?

  @@map("source_report_candidates")
}

// AI-proposed pre-fill for the Project Context form (spec §5 human-in-the-loop):
// never auto-persisted as the canonical context — the reviewer edits it and
// submits it through the same manual create/createVersion path as any
// hand-authored context. content mirrors only the fields the Context form
// actually exposes (no scopeItems yet); sourceVersionIds records which
// approved Project Source versions were used as input, for evidence (§36.4).
model ProjectContextCandidate {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  aiRunId                String   @unique @map("ai_run_id") @db.Uuid
  content                Json
  sourceVersionIds       Json     @map("source_version_ids")
  reportSourceVersionIds Json     @default("[]") @map("report_source_version_ids")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiRun   AIRun   @relation(fields: [aiRunId], references: [id], onDelete: Restrict)

  @@map("project_context_candidates")
}

// Structured interpretation of a source's extracted content (spec §8):
// summary, actors, business concepts, candidate rules/constraints, needs,
// facts, ambiguities, provenance. Immutable once created; attached to the
// same ArtifactVersion as its SourceDetail. Never an official Requirement.
model SourceReportDetail {
  artifactVersionId     String  @id @map("artifact_version_id") @db.Uuid
  content               Json
  generationCandidateId String? @unique @map("generation_candidate_id") @db.Uuid
  aiRunId               String? @map("ai_run_id") @db.Uuid

  sourceDetail SourceDetail           @relation(fields: [artifactVersionId], references: [artifactVersionId], onDelete: Restrict)
  candidate    SourceReportCandidate? @relation(fields: [generationCandidateId], references: [id], onDelete: Restrict)
  aiRun        AIRun?                 @relation(fields: [aiRunId], references: [id], onDelete: Restrict)

  @@map("source_report_details")
}

// One shared candidate-first AI generation batch for Navigation/Software
// Architecture/System Architecture/UI Blueprint (spec §13/§14/§15/§17). The
// `kind` discriminator keeps each generation scoped to exactly one artifact
// type; content shape per kind is validated by packages/contracts, not here.
model StructuredAnalysisGeneration {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String                 @map("project_id") @db.Uuid
  kind      StructuredAnalysisKind
  aiRunId   String                 @unique @map("ai_run_id") @db.Uuid
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  project         Project                              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiRun           AIRun                                @relation(fields: [aiRunId], references: [id], onDelete: Restrict)
  sources         StructuredAnalysisGenerationSource[]
  candidates      StructuredAnalysisCandidate[]
  acceptedDetails StructuredAnalysisDetail[]

  @@index([projectId, kind, createdAt])
  @@map("structured_analysis_generations")
}

model StructuredAnalysisGenerationSource {
  generationId      String @map("generation_id") @db.Uuid
  artifactVersionId String @map("artifact_version_id") @db.Uuid
  sourceId          String @map("source_id")

  generation      StructuredAnalysisGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  artifactVersion ArtifactVersion              @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)

  @@id([generationId, artifactVersionId])
  @@unique([generationId, sourceId])
  @@map("structured_analysis_generation_sources")
}

model StructuredAnalysisCandidate {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId       String                       @map("generation_id") @db.Uuid
  candidateId        String                       @map("candidate_id")
  title              String
  content            Json
  acceptedArtifactId String?                      @map("accepted_artifact_id") @db.Uuid
  generation         StructuredAnalysisGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  acceptedArtifact   Artifact?                    @relation(fields: [acceptedArtifactId], references: [id], onDelete: Restrict)
  acceptedDetail     StructuredAnalysisDetail?

  @@unique([generationId, candidateId])
  @@map("structured_analysis_candidates")
}

// Official structured snapshot for one ArtifactVersion of kind `kind`.
// Immutable once created (see migration trigger), like every other Detail.
model StructuredAnalysisDetail {
  artifactVersionId     String                 @id @map("artifact_version_id") @db.Uuid
  kind                  StructuredAnalysisKind
  content               Json
  generationId          String?                @map("generation_id") @db.Uuid
  generationCandidateId String?                @unique @map("generation_candidate_id") @db.Uuid
  aiRunId               String?                @map("ai_run_id") @db.Uuid

  artifactVersion     ArtifactVersion               @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  generation          StructuredAnalysisGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  generationCandidate StructuredAnalysisCandidate?  @relation(fields: [generationCandidateId], references: [id], onDelete: Restrict)
  aiRun               AIRun?                        @relation(fields: [aiRunId], references: [id], onDelete: Restrict)

  @@map("structured_analysis_details")
}

enum MockupGeneratorKind {
  INTERNAL_WIREFRAME
  STITCH

  @@map("mockup_generator_kind")
}

enum MockupDeviceType {
  DESKTOP
  MOBILE

  @@map("mockup_device_type")
}

// A mockup derives from one exact approved UI_BLUEPRINT version. The internal
// renderer stores SVG; Stitch stores separately downloadable screen assets.
model MockupDetail {
  artifactVersionId    String              @id @map("artifact_version_id") @db.Uuid
  uiBlueprintVersionId String              @map("ui_blueprint_version_id") @db.Uuid
  generatorVersion     String              @map("generator_version")
  generatorKind        MockupGeneratorKind @default(INTERNAL_WIREFRAME) @map("generator_kind")
  deviceType           MockupDeviceType    @default(DESKTOP) @map("device_type")
  svg                  String?
  // User instruction that produced this version by refining the previous one; null for plain generation.
  refinementPrompt     String?             @map("refinement_prompt")
  // Exact approved theme the mockup was painted with; null = standard design.
  designThemeVersionId String?             @map("design_theme_version_id") @db.Uuid

  artifactVersion    ArtifactVersion      @relation("MockupOwnVersion", fields: [artifactVersionId], references: [id], onDelete: Restrict)
  uiBlueprintVersion ArtifactVersion      @relation("MockupUiBlueprintSource", fields: [uiBlueprintVersionId], references: [id], onDelete: Restrict)
  designThemeVersion ArtifactVersion?     @relation("MockupDesignThemeSource", fields: [designThemeVersionId], references: [id], onDelete: Restrict)
  screens            MockupScreenDetail[]

  @@map("mockup_details")
}

model MockupScreenDetail {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mockupVersionId  String  @map("mockup_version_id") @db.Uuid
  screenLocalId    String  @map("screen_local_id")
  screenName       String  @map("screen_name")
  imageStorageKey  String  @map("image_storage_key")
  imageContentType String  @map("image_content_type")
  htmlStorageKey   String  @map("html_storage_key")
  // Stitch project/screen that produced this image, so the screen can be edited
  // in place later. Null for screens generated before this was recorded.
  stitchProjectId  String? @map("stitch_project_id")
  stitchScreenId   String? @map("stitch_screen_id")
  // Instruction that produced this screen by editing the previous version's screen.
  refinementPrompt String? @map("refinement_prompt")

  mockup MockupDetail @relation(fields: [mockupVersionId], references: [artifactVersionId], onDelete: Restrict)

  @@unique([mockupVersionId, screenLocalId])
  @@map("mockup_screen_details")
}

enum MockupJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("mockup_job_status")
}

enum SourceProcessingStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED

  @@map("source_processing_status")
}

model SourceProcessingJob {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String                 @map("project_id") @db.Uuid
  sourceVersionId String                 @unique @map("source_version_id") @db.Uuid
  status          SourceProcessingStatus @default(QUEUED)
  processor       String
  errorMessage    String?                @map("error_message")
  failureReason   SourceFailureReason?   @map("failure_reason")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceVersion ArtifactVersion @relation(fields: [sourceVersionId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([projectId, status])
  @@map("source_processing_jobs")
}

// Tracks an async mockup generation request (spec §40 job states), so the
// HTTP request that creates it never blocks on Stitch's real latency.
// existingMockupId is set only when the job regenerates a version of an
// already-approved mockup artifact; null means a brand-new one.
model MockupGenerationJob {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String           @map("project_id") @db.Uuid
  uiBlueprintVersionId String           @map("ui_blueprint_version_id") @db.Uuid
  existingMockupId     String?          @map("existing_mockup_id") @db.Uuid
  deviceType           MockupDeviceType @default(DESKTOP) @map("device_type")
  refinementPrompt     String?          @map("refinement_prompt")
  // Set only for a single-screen edit: the blueprint localId of the screen to edit.
  screenLocalId        String?          @map("screen_local_id")
  status               MockupJobStatus  @default(QUEUED)
  resultArtifactId     String?          @map("result_artifact_id") @db.Uuid
  errorMessage         String?          @map("error_message")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("mockup_generation_jobs")
}

// Knowledge Base Fragment for RAG (spec Increment 2)
model SourceFragment {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceVersionId String                       @map("source_version_id") @db.Uuid
  projectId       String                       @map("project_id") @db.Uuid
  sequence        Int
  content         String
  page            String?
  section         String?
  speaker         String?
  timestamp       String?
  embedding       Unsupported("vector(1536)")?

  @@map("source_fragments")
}

// Immutable snapshot of all approved project artifacts (spec Increment 5)
model ProjectBaseline {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  label           String
  description     String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String   @map("created_by_user_id") @db.Uuid

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                   @relation(fields: [createdByUserId], references: [id])
  entries ProjectBaselineEntry[]

  @@map("project_baselines")
}

model ProjectBaselineEntry {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baselineId        String @map("baseline_id") @db.Uuid
  artifactId        String @map("artifact_id") @db.Uuid
  artifactVersionId String @map("artifact_version_id") @db.Uuid

  baseline        ProjectBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  artifact        Artifact        @relation(fields: [artifactId], references: [id])
  artifactVersion ArtifactVersion @relation(fields: [artifactVersionId], references: [id])

  @@unique([baselineId, artifactId])
  @@map("project_baseline_entries")
}

// Append-only domain/security audit trail (AGENTS.md §35). Rows are never
// updated or deleted: a database trigger rejects both. Distinct from logs.
model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  // Null for events the system produces on its own (e.g. a background job).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  // Non-sensitive context only; never secrets or provider payloads.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

enum DependencyLayer {
  FRONTEND
  BACKEND
  SHARED

  @@map("dependency_layer")
}

enum DependencyProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("dependency_proposal_status")
}

// A package a generated project needs that is outside its TargetTemplate's
// Approved Dependency Catalog (spec §155, DEC-100). An approval is an exception
// for this project only — the shared template catalog never changes. Decided
// once: a partial unique index allows one open-or-approved proposal per package.
model DependencyProposal {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                String                   @map("project_id") @db.Uuid
  targetTemplateIdentifier String                   @map("target_template_identifier")
  targetTemplateVersion    Int                      @map("target_template_version")
  packageName              String                   @map("package_name")
  version                  String
  layer                    DependencyLayer
  dev                      Boolean                  @default(false)
  justification            String
  status                   DependencyProposalStatus @default(PENDING)
  // Null when a generation run requested it rather than a person.
  requestedByUserId        String?                  @map("requested_by_user_id") @db.Uuid
  decidedByUserId          String?                  @map("decided_by_user_id") @db.Uuid
  decidedAt                DateTime?                @map("decided_at") @db.Timestamptz(6)
  decisionNote             String?                  @map("decision_note")
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("DependencyProposalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("DependencyProposalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@map("dependency_proposals")
}

// Artifacts a Design Baseline freezes; values equal their artifact type code.
enum DesignBaselineRole {
  GENERATION_PLAN
  CONCEPTUAL_DOMAIN_MODEL
  CLASS_DIAGRAM
  NAVIGATION_TREE
  UI_BLUEPRINT
  DESIGN_THEME
  MOCKUP
  SOFTWARE_ARCHITECTURE
  SYSTEM_ARCHITECTURE

  @@map("design_baseline_role")
}

// Approved, frozen design (spec §160, DEC-094): the exact approved versions an
// official ImplementationPlan and code generation are built from. Creating
// one is the human Design Gate approval; rows are immutable afterwards.
model DesignBaseline {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  label            String
  note             String?
  approvedByUserId String         @map("approved_by_user_id") @db.Uuid
  // AUTOMATIC in the BUILD_ONLY route (set by a database trigger).
  approvalOrigin   ApprovalOrigin @default(HUMAN) @map("approval_origin")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvedBy     User                       @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  entries        DesignBaselineEntry[]
  generationRuns GenerationRun[]
  snapshots      GeneratedProjectSnapshot[]

  @@index([projectId, createdAt])
  @@map("design_baselines")
}

model DesignBaselineEntry {
  baselineId        String             @map("baseline_id") @db.Uuid
  role              DesignBaselineRole
  artifactVersionId String             @map("artifact_version_id") @db.Uuid

  baseline        DesignBaseline  @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  artifactVersion ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)

  @@id([baselineId, role])
  @@map("design_baseline_entries")
}

enum GenerationRunStatus {
  QUEUED
  GENERATING
  GENERATED
  FAILED

  @@map("generation_run_status")
}

enum GeneratedFileOrigin {
  TEMPLATE
  DETERMINISTIC
  AI_ASSISTED

  @@map("generated_file_origin")
}

enum GeneratedFileKind {
  SOURCE
  TEST
  CONFIG
  DOCUMENTATION

  @@map("generated_file_kind")
}

enum CodeTraceLinkType {
  IMPLEMENTS
  TESTS
  CONFIGURES

  @@map("code_trace_link_type")
}

// One official code generation from an approved Implementation Plan (spec
// §197). A retry is a new run: finished runs and their files are history.
model GenerationRun {
  id                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                   String              @map("project_id") @db.Uuid
  implementationPlanVersionId String              @map("implementation_plan_version_id") @db.Uuid
  designBaselineId            String              @map("design_baseline_id") @db.Uuid
  targetTemplateIdentifier    String              @map("target_template_identifier")
  targetTemplateVersion       Int                 @map("target_template_version")
  status                      GenerationRunStatus @default(QUEUED)
  errorMessage                String?             @map("error_message")
  // Non-fatal outcomes a reviewer must see (e.g. an action left unimplemented).
  warnings                    String[]            @default([])
  createdByUserId             String              @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt                   DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt                  DateTime?           @map("finished_at") @db.Timestamptz(6)

  project                   Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  implementationPlanVersion ArtifactVersion           @relation(fields: [implementationPlanVersionId], references: [id], onDelete: Restrict)
  designBaseline            DesignBaseline            @relation(fields: [designBaselineId], references: [id], onDelete: Restrict)
  createdBy                 User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  files                     GeneratedFile[]
  sandboxRuns               SandboxRun[]
  repairAttempts            AutoRepairAttempt[]
  snapshot                  GeneratedProjectSnapshot?

  @@index([projectId, createdAt])
  @@map("generation_runs")
}

model GeneratedFile {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationRunId String              @map("generation_run_id") @db.Uuid
  path            String
  content         String
  sha256          String
  origin          GeneratedFileOrigin
  kind            GeneratedFileKind

  generationRun GenerationRun   @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  traceLinks    CodeTraceLink[]

  @@unique([generationRunId, path])
  @@map("generated_files")
}

// Construction traceability (DEC-106): which approved artifact version, and
// which element of the plan, each generated file implements, tests or configures.
model CodeTraceLink {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generatedFileId         String            @map("generated_file_id") @db.Uuid
  sourceArtifactVersionId String            @map("source_artifact_version_id") @db.Uuid
  planElement             String            @map("plan_element")
  linkType                CodeTraceLinkType @map("link_type")

  generatedFile         GeneratedFile   @relation(fields: [generatedFileId], references: [id], onDelete: Restrict)
  sourceArtifactVersion ArtifactVersion @relation(fields: [sourceArtifactVersionId], references: [id], onDelete: Restrict)

  @@unique([generatedFileId, sourceArtifactVersionId, planElement])
  @@index([sourceArtifactVersionId])
  @@map("code_trace_links")
}

enum SandboxRunStatus {
  QUEUED
  RUNNING
  READY
  // This attempt failed and a repaired attempt follows.
  FAILED
  // Terminal: validation failed and no further repair is possible.
  VALIDATION_FAILED
  // Terminal: the sandbox itself was unavailable; says nothing about the code.
  ERROR

  @@map("sandbox_run_status")
}

enum ValidationStage {
  INSTALL
  LINT
  TYPECHECK
  TEST
  BUILD
  STRUCTURE
  TRACEABILITY

  @@map("validation_stage")
}

enum AutoRepairStatus {
  PATCHED
  NO_PATCH
  REJECTED

  @@map("auto_repair_status")
}

// One validation attempt of a generation run inside the sandbox (spec §174-175).
model SandboxRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String           @map("project_id") @db.Uuid
  generationRunId String           @map("generation_run_id") @db.Uuid
  attemptNumber   Int              @map("attempt_number")
  status          SandboxRunStatus @default(QUEUED)
  currentStage    ValidationStage? @map("current_stage")
  failedStage     ValidationStage? @map("failed_stage")
  errorMessage    String?          @map("error_message")
  // Lockfile resolved by the sandbox install; shipped in the snapshot ZIP.
  lockfile        String?
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?        @map("finished_at") @db.Timestamptz(6)

  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  generationRun GenerationRun             @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  stageResults  SandboxStageResult[]
  repairAttempt AutoRepairAttempt?
  snapshot      GeneratedProjectSnapshot?

  @@index([generationRunId, createdAt])
  @@map("sandbox_runs")
}

model SandboxStageResult {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxRunId String          @map("sandbox_run_id") @db.Uuid
  stage        ValidationStage
  passed       Boolean
  exitCode     Int?            @map("exit_code")
  timedOut     Boolean         @default(false) @map("timed_out")
  durationMs   Int             @map("duration_ms")
  // Sanitized tail of the stage output.
  output       String

  sandboxRun SandboxRun @relation(fields: [sandboxRunId], references: [id], onDelete: Restrict)

  @@unique([sandboxRunId, stage])
  @@map("sandbox_stage_results")
}

// Bounded repair round (DEC-103, max 3) after a failed attempt.
model AutoRepairAttempt {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationRunId String           @map("generation_run_id") @db.Uuid
  sandboxRunId    String           @unique @map("sandbox_run_id") @db.Uuid
  roundNumber     Int              @map("round_number")
  failedStage     ValidationStage  @map("failed_stage")
  status          AutoRepairStatus
  explanation     String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  generationRun GenerationRun   @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  sandboxRun    SandboxRun      @relation(fields: [sandboxRunId], references: [id], onDelete: Restrict)
  patches       RepairPatch[]
  findings      RepairFinding[]

  @@unique([generationRunId, roundNumber])
  @@map("auto_repair_attempts")
}

model RepairPatch {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autoRepairAttemptId String @map("auto_repair_attempt_id") @db.Uuid
  path                String
  previousSha256      String @map("previous_sha256")
  content             String
  sha256              String

  attempt AutoRepairAttempt @relation(fields: [autoRepairAttemptId], references: [id], onDelete: Restrict)

  @@unique([autoRepairAttemptId, path])
  @@map("repair_patches")
}

// An upstream inconsistency a repair found; approved artifacts are never edited.
model RepairFinding {
  id                       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autoRepairAttemptId      String  @map("auto_repair_attempt_id") @db.Uuid
  message                  String
  relatedArtifactVersionId String? @map("related_artifact_version_id") @db.Uuid

  attempt                AutoRepairAttempt @relation(fields: [autoRepairAttemptId], references: [id], onDelete: Restrict)
  relatedArtifactVersion ArtifactVersion?  @relation(fields: [relatedArtifactVersionId], references: [id], onDelete: Restrict)

  @@index([autoRepairAttemptId])
  @@map("repair_findings")
}

// Immutable official result of a validated generation (spec §172, DEC-104/105).
model GeneratedProjectSnapshot {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                   String   @map("project_id") @db.Uuid
  generationRunId             String   @unique @map("generation_run_id") @db.Uuid
  sandboxRunId                String   @unique @map("sandbox_run_id") @db.Uuid
  targetTemplateIdentifier    String   @map("target_template_identifier")
  targetTemplateVersion       Int      @map("target_template_version")
  generationPlanVersionId     String?  @map("generation_plan_version_id") @db.Uuid
  designBaselineId            String   @map("design_baseline_id") @db.Uuid
  implementationPlanVersionId String   @map("implementation_plan_version_id") @db.Uuid
  fileCount                   Int      @map("file_count")
  manifestHash                String   @map("manifest_hash")
  archiveStorageKey           String   @map("archive_storage_key")
  archiveSha256               String   @map("archive_sha256")
  archiveSize                 Int      @map("archive_size")
  createdByUserId             String   @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project                   Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  generationRun             GenerationRun    @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  sandboxRun                SandboxRun       @relation(fields: [sandboxRunId], references: [id], onDelete: Restrict)
  generationPlanVersion     ArtifactVersion? @relation("SnapshotGenerationPlan", fields: [generationPlanVersionId], references: [id], onDelete: Restrict)
  designBaseline            DesignBaseline   @relation(fields: [designBaselineId], references: [id], onDelete: Restrict)
  implementationPlanVersion ArtifactVersion  @relation("SnapshotImplementationPlan", fields: [implementationPlanVersionId], references: [id], onDelete: Restrict)
  createdBy                 User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("generated_project_snapshots")
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  COMPLETED
  FAILED

  @@map("workflow_run_status")
}

// One orchestration from the initial prompt through the existing stages
// (DEC-116, DEC-111): one stage at a time, stopping at the first failure.
model WorkflowRun {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  prompt          String
  status          WorkflowRunStatus @default(QUEUED)
  currentStage    String?           @map("current_stage")
  errorMessage    String?           @map("error_message")
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?         @map("finished_at") @db.Timestamptz(6)

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  stages    WorkflowRunStage[]

  @@index([projectId, createdAt])
  @@map("workflow_runs")
}

// A completed stage; a retried run skips it.
model WorkflowRunStage {
  runId       String   @map("run_id") @db.Uuid
  stage       String
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([runId, stage])
  @@map("workflow_run_stages")
}
