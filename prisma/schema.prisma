model RequirementDetail {
  artifactVersionId      String                     @id @map("artifact_version_id") @db.Uuid
  requirementType        RequirementType            @map("requirement_type")
  name                   String
  description            String
  priority               RequirementPriority
  generationCandidateId  String?                    @unique @map("generation_candidate_id") @db.Uuid
  sourceContextVersionId String?                    @map("source_context_version_id") @db.Uuid
  aiRunId                String?                    @map("ai_run_id") @db.Uuid
  // Null only for requirements written before DEC-126.
  originKind             RequirementOriginKind?     @map("origin_kind")
  originJustification    String?                    @map("origin_justification")
  artifactVersion        ArtifactVersion            @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  sourceContextVersion   ArtifactVersion?           @relation("RequirementSourceContext", fields: [sourceContextVersionId], references: [id], onDelete: Restrict)
  aiRun                  AIRun?                     @relation(fields: [aiRunId], references: [id], onDelete: Restrict)
  actors                 RequirementActor[]
  preconditions          RequirementPrecondition[]
  postconditions         RequirementPostcondition[]
  dependencies           RequirementDependency[]
  contextLinks           RequirementContextLink[]

  @@map("requirement_details")
}

// The context items a requirement version answers (DEC-126): exactly one of
// a need, a constraint or a business rule of a Project Context version of
// the same project. Insert-only, like every other requirement row.
model RequirementContextLink {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactVersionId String                      @map("artifact_version_id") @db.Uuid
  needId            String?                     @map("need_id") @db.Uuid
  constraintId      String?                     @map("constraint_id") @db.Uuid
  businessRuleId    String?                     @map("business_rule_id") @db.Uuid
  requirement       RequirementDetail           @relation(fields: [artifactVersionId], references: [artifactVersionId], onDelete: Restrict)
  need              ProjectContextNeed?         @relation(fields: [needId], references: [id], onDelete: Restrict)
  constraint        ProjectContextConstraint?   @relation(fields: [constraintId], references: [id], onDelete: Restrict)
  businessRule      ProjectContextBusinessRule? @relation(fields: [businessRuleId], references: [id], onDelete: Restrict)

  @@unique([artifactVersionId, needId])
  @@unique([artifactVersionId, constraintId])
  @@unique([artifactVersionId, businessRuleId])
  @@index([needId])
  @@index([constraintId])
  @@index([businessRuleId])
  @@map("requirement_context_links")
}

model RequirementActor {
