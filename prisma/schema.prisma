model RequirementCandidate {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId         String                           @map("generation_id") @db.Uuid
  candidateId          String                           @map("candidate_id")
  requirementType      RequirementType                  @map("requirement_type")
  name                 String
  description          String
  priority             RequirementPriority
  actors               Json
  preconditions        Json
  postconditions       Json
  // Codes (N-1, RES-2, RN-3) of the context items the proposal answers.
  contextItemCodes     Json                             @default("[]") @map("context_item_codes")
  // An idea beyond the context, with the reason to consider it (DEC-126).
  suggested            Boolean                          @default(false)
  rationale            String?
  acceptedArtifactId   String?                          @map("accepted_artifact_id") @db.Uuid
  generation           RequirementGeneration            @relation(fields: [generationId], references: [id], onDelete: Restrict)
  outgoingDependencies RequirementCandidateDependency[] @relation("CandidateFrom")
  incomingDependencies RequirementCandidateDependency[] @relation("CandidateTo")

  @@unique([generationId, candidateId])
  @@map("requirement_candidates")
}

model RequirementCandidateDependency {
  candidateId          String               @map("candidate_id") @db.Uuid
  dependsOnCandidateId String               @map("depends_on_candidate_id") @db.Uuid
