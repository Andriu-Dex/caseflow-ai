  dependsOn            RequirementCandidate @relation("CandidateTo", fields: [dependsOnCandidateId], references: [id], onDelete: Restrict)

  @@id([candidateId, dependsOnCandidateId])
  @@map("requirement_candidate_dependencies")
}

