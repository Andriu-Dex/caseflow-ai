{
  "name": "@caseflow-ai/worker",
  "version": "0.1.0",
  "private": true,
  "description": "CASEFlow AI worker application (NestJS standalone foundation)",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --require ts-node/register src/main.ts",
    "build": "pnpm --filter @caseflow-ai/domain run build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "pnpm --filter @caseflow-ai/domain run build && tsc --noEmit"
  },
  "dependencies": {
    "@caseflow-ai/domain": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.13.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
