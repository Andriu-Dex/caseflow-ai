{
  "name": "@caseflow-ai/api",
  "version": "0.1.0",
  "private": true,
  "description": "CASEFlow AI API application (NestJS foundation)",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "openapi:generate": "node dist/openapi/generate-openapi.js",
    "typecheck": "pnpm --filter @caseflow-ai/ai run build && pnpm --filter @caseflow-ai/config run build && pnpm --filter @caseflow-ai/integrations run build && tsc --noEmit"
  },
  "dependencies": {
    "@caseflow-ai/ai": "workspace:*",
    "@caseflow-ai/config": "workspace:*",
    "@caseflow-ai/contracts": "workspace:*",
    "@caseflow-ai/domain": "workspace:*",
    "@caseflow-ai/integrations": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fast-xml-parser": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
