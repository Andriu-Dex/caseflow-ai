# CASEFlow AI — environment variable placeholders
# Copy this file to .env and provide real values locally.
# No secrets belong in this file or in version control.
# These are local development defaults matching infra/docker/compose.yml.

NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional AI generation. Disabled mode requires no provider credentials and
# leaves all manual CASE functionality available.
#
# AI_PROVIDER=openai_compatible uses a single OpenAI-compatible endpoint
# (AI_BASE_URL/AI_API_KEY/AI_MODEL below).
#
# AI_PROVIDER=fallback chains multiple free-tier OpenAI-compatible providers
# instead (e.g. Groq, then Gemini): each numbered AI_PROVIDER_N_* slot is
# tried in order and the next one is used only when the current slot fails
# (rate limit, timeout, error). Slots stop at the first missing
# AI_PROVIDER_N_BASE_URL. AI_TIMEOUT_MS applies to every slot.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
# Maximum simultaneous local requirement jobs (1-4); one by default.
REQUIREMENT_GENERATION_CONCURRENCY=1
# Check https://console.groq.com/docs/models and https://ai.google.dev/gemini-api/docs/models
# for the model ids actually available to your account before copying these.
# AI_PROVIDER_1_ID=groq
# AI_PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
# AI_PROVIDER_1_API_KEY=
# AI_PROVIDER_1_MODEL=openai/gpt-oss-120b
# AI_PROVIDER_2_ID=gemini
# AI_PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_PROVIDER_2_API_KEY=
# AI_PROVIDER_2_MODEL=gemini-3.8-flash
# Gemini's OpenAI-compatible endpoint supports a narrower JSON Schema dialect
# than full OpenAI strict json_schema mode (confirmed by direct testing:
# rejects minLength/maxLength/minItems/maxItems/const). "narrow" adapts the
# schema sent to it at the provider boundary only; domain validation is
# unaffected. Omit (or "strict") for providers with full strict-mode support.
# AI_PROVIDER_2_SCHEMA_DIALECT=narrow
# What each plan accepts (DEC-127): requests are sent only to a slot they
# fit in, a spent daily quota is skipped until it resets, and work too large
# for every slot is split. Values verified for free tiers in October 2026:
# Groq rejects any request above 8 000 tokens per minute; Gemini takes up to
# 1 048 576 input tokens, 250 000 per minute, 20 requests a day, resetting at
# midnight Pacific time. Check your own plan before copying them.
# AI_PROVIDER_1_TOKENS_PER_MINUTE=8000
# AI_PROVIDER_2_MAX_INPUT_TOKENS=1048576
# AI_PROVIDER_2_TOKENS_PER_MINUTE=250000
# AI_PROVIDER_2_DAY_RESET_TIMEZONE=America/Los_Angeles
# How much each provider may write per answer (DEC-131). Each task asks for
# what it needs at least; a declared ceiling raises that, never lowers it.
# Leave it unset on a provider whose per-minute limit counts the requested
# output (Groq), so small requests keep fitting.
# AI_PROVIDER_2_MAX_OUTPUT_TOKENS=65536

# ChatGPT plan in local development (DEC-128): set AI_PROVIDER=chatgpt and
# `pnpm dev` starts a broker that opens the browser to sign in. Credentials
# stay in its memory; sign in again after restarting `pnpm dev`. Never on a
# hosted deployment. AI_MODEL must be one of your plan's models (the broker
# lists them). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AI_PROVIDER=chatgpt
# AI_MODEL=
# AI_TIMEOUT_MS=120000
# AI_MAX_INPUT_TOKENS=
# What the plan's model may write per answer (DEC-131); unset: each task's own.
# AI_MAX_OUTPUT_TOKENS=
# CHATGPT_BROKER_URL=http://127.0.0.1:47833
# CASEFLOW_WEB_URL=http://localhost:3000
# CHATGPT_BROKER_SECRET=

# Diagram rendering (local Kroki — never a public kroki.io endpoint).
# DIAGRAM_RENDERER=disabled requires no infrastructure but rejects any render
# request; ordinary manual CASE work still needs a real renderer configured.
DIAGRAM_RENDERER=kroki
KROKI_BASE_URL=http://localhost:8000
DIAGRAM_RENDER_TIMEOUT_MS=10000

# Bocetos (paso 10). Sin Stitch se usa el wireframe interno. Si Stitch falla,
# el generador interno permanece disponible como fallback.
MOCKUP_PROVIDER=disabled
# STITCH_API_KEY=
# Time limit of one screen (Stitch takes about two minutes a screen).
# STITCH_TIMEOUT_MS=240000
# Screens drawn at the same time (1-8).
# STITCH_CONCURRENCY=4

# Optional audio transcription through an OpenAI-compatible /audio/transcriptions
# endpoint. With these unset, uploaded audio remains available for manual text.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
# Local OCR (Spanish + English) uses Tesseract.js. Language models are cached
# after their first download; if unavailable, manual correction remains possible.

# PostgreSQL / Prisma
DATABASE_URL=postgresql://caseflow:caseflow-local-dev@localhost:5433/caseflow?schema=public

# PostgreSQL — dedicated test database, used only by integration tests
# (see scripts/prepare-test-database.mjs and `pnpm db:test:prepare`).
DATABASE_TEST_URL=postgresql://caseflow:caseflow-local-dev@localhost:5433/caseflow_test?schema=public

# Optional one-time migration of legacy workspaces/projects to an explicitly
# designated initial account. Set only when running scripts/backfill-raw.mjs.
BACKFILL_OWNER_EMAIL=

# Redis. Use 127.0.0.1, not localhost: on Windows "localhost" may resolve to
# IPv6 (::1), where WSL's port relay can hold 6379 without answering, and every
# queued job then hangs.
REDIS_URL=redis://127.0.0.1:6379

# Limits on authentication attempts (docs/decisions/ADR-011). Counted per client
# address, and for sign-in also per address and account, in fixed windows that end
# by themselves (a 429 carries Retry-After; nobody stays blocked). Shared through
# Redis when REDIS_URL is set; in memory for the desktop edition. Defaults below.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_STORE=auto            # auto | redis | memory
# AUTH_LOGIN_ACCOUNT_MAX=10             # attempts per address and account...
# AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=900 # ...in this window (success resets it)
# AUTH_LOGIN_ADDRESS_MAX=300            # all sign-in attempts from one address
# AUTH_LOGIN_ADDRESS_WINDOW_SECONDS=900
# AUTH_REGISTER_ADDRESS_MAX=50
# AUTH_REGISTER_ADDRESS_WINDOW_SECONDS=3600
# AUTH_REFRESH_ADDRESS_MAX=120
# AUTH_REFRESH_ADDRESS_WINDOW_SECONDS=60
# Proxies whose X-Forwarded-For may be believed to find the client address. Unset
# (default): none, the connection's address is used. A hop count (1), a preset
# (loopback) or a list of addresses/CIDR ranges. Never "true".
# TRUSTED_PROXIES=

# apps/worker calls back into apps/api over this internal, non-browser route
# after popping a mockup-generation job off the queue — never reachable from
# the browser. INTERNAL_JOBS_SECRET must be the same value in both apps.
API_INTERNAL_URL=http://localhost:3001
INTERNAL_JOBS_SECRET=

# S3-compatible storage (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=caseflow
S3_ACCESS_KEY_ID=caseflow
S3_SECRET_ACCESS_KEY=caseflow-local-dev
S3_REGION=us-east-1

# Desktop edition only (DEC-120), set by apps/desktop: jobs run in process
# without Redis, and objects are stored in a folder instead of S3.
# CASEFLOW_QUEUE_MODE=in-process
# STORAGE_DIR=

# Mailpit (local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
