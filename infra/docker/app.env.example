# CASEFlow AI, self-hosted edition (infra/docker/compose.app.yml).
# Copy to infra/docker/app.env and change every "change-me" value. Keep it out
# of version control. Use letters and digits only in the passwords and keys.

# Required. Generate each one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-at-least-32-characters-long-secret
INTERNAL_JOBS_SECRET=change-me-internal-jobs-secret
S3_ACCESS_KEY_ID=change-me-access-key
S3_SECRET_ACCESS_KEY=change-me-secret-key-of-the-storage

# Where the application is reached. The web image bakes PUBLIC_API_URL in when it
# is built, so rebuild (up --build) after changing it. Refresh cookies are
# Secure in production: outside localhost, serve both behind HTTPS.
WEB_PORT=3000
API_PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# Behind a reverse proxy, name it here (an address, a CIDR range or loopback) so the
# API counts sign-in attempts per real client and not per proxy. Leave it empty when
# the API is reached directly, and never list a proxy that is not yours.
# TRUSTED_PROXIES=

# Optional AI. With "disabled" all manual CASE work remains available.
AI_PROVIDER=disabled
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=120000

# Optional mockups through Stitch; without it the internal wireframe is used.
MOCKUP_PROVIDER=disabled
# STITCH_API_KEY=
