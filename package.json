{
  "name": "caseflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CASEFlow AI monorepo",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c blue,green,yellow \"pnpm --filter @caseflow-ai/web run dev\" \"pnpm --filter @caseflow-ai/api run dev\" \"pnpm --filter @caseflow-ai/worker run dev\"",
    "dev:web": "pnpm --filter @caseflow-ai/web run dev",
    "dev:api": "pnpm --filter @caseflow-ai/api run dev",
    "dev:worker": "pnpm --filter @caseflow-ai/worker run dev",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json && pnpm -r --if-present run typecheck",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "infra:status": "docker compose -f infra/docker/compose.yml ps",
    "infra:logs": "docker compose -f infra/docker/compose.yml logs -f",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepare-test-database.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:coverage",
    "verify:integration": "pnpm run db:test:prepare && pnpm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
