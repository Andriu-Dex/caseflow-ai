{
  "name": "@caseflow-ai/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "CASEFlow AI external integration adapters",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "pnpm --filter @caseflow-ai/ai run build && tsc --noEmit --pretty"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@caseflow-ai/ai": "workspace:*"
  }
}
